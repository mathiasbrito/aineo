{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-branch.sh\"",
            "timeout": 10,
            "statusMessage": "Checking branch policy"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-review-before-commit.sh\"",
            "if": "Bash(git *)",
            "timeout": 10,
            "statusMessage": "Checking the staged changes were reviewed"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-worktree-cd.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the session stays in its checkout"
          }
        ]
      }
    ]
  }
}
